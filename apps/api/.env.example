# LinguaGraph API — environment example (non-secret development values only).
# Copy to `.env` (never commit) or export in the shell.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver).
# HRA-F05 (R1): explicit IPv4 loopback 127.0.0.1 — deterministic on Windows,
# where `localhost` may resolve to ::1 first (no PostgreSQL there) and stall
# connection establishment. This is the repo-provided default for the local
# Docker Compose PostgreSQL 18 service; custom hosts are never rewritten.
DATABASE_URL=postgresql+psycopg://linguagraph:linguagraph@127.0.0.1:5432/linguagraph

# Server used by integration/migration tests to create disposable databases.
# Falls back to DATABASE_URL when unset.
TEST_DATABASE_URL=postgresql+psycopg://linguagraph:linguagraph@127.0.0.1:5432/linguagraph_test

# Comma-separated CORS origins allowed to call the API (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Text size limits (see M0_PREIMPLEMENTATION_REPORT.md, section 6).
MAX_TEXT_VERSION_CODEPOINTS=1000000
MAX_REQUEST_BODY_BYTES=4000000

# Logging level.
LOG_LEVEL=INFO
